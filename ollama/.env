# ─────────────────────────────────────────────────────────────
# Ollama 실행 설정  (docker-compose.yml 이 읽습니다)
# 환경: RTX 5090 32GB × 1, Blackwell(sm_120), 드라이버 580.173.02
# ─────────────────────────────────────────────────────────────

# 이미지 태그
#   ⚠️ Blackwell(sm_120)은 CUDA 12.8+ 가 필요합니다.
#   구버전 이미지는 "no kernel image is available" 로 죽습니다.
#   문제가 생기면 latest 로 pull 하세요: docker compose pull
OLLAMA_IMAGE_TAG=latest

# 호스트에 노출할 포트 (opencode 등이 붙는 자리)
OLLAMA_PORT=11434

# 모델 저장 경로 (호스트 기준 상대경로)
#   3단계에서 같은 모델의 여러 양자화를 받으면 쉽게 100GB를 넘깁니다.
#   named volume 대신 bind mount 를 쓰는 이유: du -sh ./models 로 용량이 눈에 보입니다.
OLLAMA_MODELS_DIR=./models

# ── 컨텍스트 길이 ────────────────────────────────────────────
#   Ollama 기본값은 4096 입니다. 모델이 256K를 지원해도 4096으로 잘립니다.
#   - 커리큘럼 8단계: 4096 → 8192 → 16384 → 32768 로 올려가며 실습
#   - 코딩 에이전트(opencode) 연결 시: 최소 16384, 권장 65536
#   올릴 때마다 VRAM(KV 캐시) 사용량을 함께 기록하세요.
OLLAMA_CONTEXT_LENGTH=8192

# ── 모델 메모리 상주 시간 ────────────────────────────────────
#   기본 5m. 벤치마크 중에 언로드되면 측정값이 오염됩니다.
#   측정 세션 동안은 -1 (무한 상주) 로 두는 것을 권장합니다.
OLLAMA_KEEP_ALIVE=-1

# ── 동시 로딩 모델 수 ────────────────────────────────────────
#   3단계에서 FP16/Q8/Q4 를 번갈아 측정할 때 매번 로딩을 기다리지 않게 해줍니다.
#   VRAM 32GB 기준: 8B 급 2개까지는 여유. 14B 를 섞으면 1로 낮추세요.
OLLAMA_MAX_LOADED_MODELS=2

# ── 모델당 병렬 요청 수 ──────────────────────────────────────
#   커리큘럼 7단계(배치)의 Ollama 쪽 대응물.
#   주의: 올리면 KV 캐시가 이 값에 비례해 늘어납니다 (배치 × 컨텍스트).
OLLAMA_NUM_PARALLEL=1

# ── Flash Attention ──────────────────────────────────────────
#   메모리 사용량 감소 + 속도 향상. 15단계에서 개념을 다룹니다.
#   3단계 측정 시에는 0/1 을 모두 재보고 차이를 기록해보세요.
OLLAMA_FLASH_ATTENTION=1

# ── KV 캐시 정밀도 ───────────────────────────────────────────
#   f16(기본) | q8_0 | q4_0
#   q8_0 으로 내리면 KV 캐시가 절반. 8단계에서 품질 영향을 직접 재보세요.
#   (FLASH_ATTENTION=1 이 필요합니다)
OLLAMA_KV_CACHE_TYPE=f16

# ── 사용할 GPU ───────────────────────────────────────────────
#   GPU 1대이므로 0. 여러 대가 되면 "0,1" 형태.
CUDA_VISIBLE_DEVICES=0

# ── 디버그 로그 ──────────────────────────────────────────────
#   1로 켜면 레이어 배치, VRAM 할당, 프롬프트 처리 시간이 로그에 찍힙니다.
#   커리큘럼 5·6단계에서 prefill/decode 감각을 잡는 데 유용합니다.
OLLAMA_DEBUG=0
